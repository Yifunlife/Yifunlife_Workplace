{
  "name": "yifunlife-workplace",
  "main": "cloudflare/container-worker.js",
  "account_id": "5a472d15dc37681abce4ab6e4eb152c3",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "python3 prepare_source.py"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.js.txt"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "AUTH_MODE": "access",
    "PUBLIC_ORIGIN": "https://yifunlife-workplace.yifunlife.workers.dev",
    "OWNER_EMAIL": "markfang458@hotmail.com",
    "VIEWER_EMAILS": "yifunlife@hotmail.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKPLACE_CONTAINER",
        "class_name": "WorkplaceContainer"
      },
      {
        "name": "BUSINESS_DATABASE",
        "class_name": "BusinessDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "workplace-cloud-v1",
      "new_sqlite_classes": [
        "WorkplaceContainer",
        "BusinessDatabase"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "WorkplaceContainer",
      "image": "registry.cloudflare.com/5a472d15dc37681abce4ab6e4eb152c3/yifunlife-workplace:414c268711901b55dcccc981516e4cf198d5a69a",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CORE_FILES",
      "bucket_name": "yifun-workplace-core-files"
    },
    {
      "binding": "QUOTE_FILES",
      "bucket_name": "yifun-workplace-quote-files"
    },
    {
      "binding": "PROCUREMENT_FILES",
      "bucket_name": "yifun-workplace-procurement-files"
    },
    {
      "binding": "AFTERSALES_FILES",
      "bucket_name": "yifun-workplace-aftersales-files"
    }
  ]
}
